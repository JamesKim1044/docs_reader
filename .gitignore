# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
*.so

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Test / type / lint / coverage caches ─────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Local secrets & config (keep .env.example tracked) ───────────────────────
.env
.env.local
*.local

# ── Sample & generated data ──────────────────────────────────────────────────
# samples/: real (private) user documents + demos regeneratable via tools/make_samples.py
# eval/dataset/: labeled fixtures regeneratable via tools/make_eval_dataset.py
samples/
eval/dataset/

# ── Runtime outputs / artifacts ──────────────────────────────────────────────
extracted_images/
out/
*.log
ollama_gpu/
*.tgz

# NOTE: schemas/*.json (invoice.json, *.examples.json) are intentionally tracked.

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
