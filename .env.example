# docs_reader configuration — copy to `.env` and edit.
# Loaded automatically (python-dotenv). Real shell env vars always win over this file.

# ── Provider selection ────────────────────────────────────────────────────────
# opensource (default) | gemini | claude | mock
# DOCS_READER_PROVIDER=opensource

# ── Open-source backend: any OpenAI-compatible endpoint (vLLM / Ollama / ...) ──
DOCS_READER_BASE_URL=http://localhost:11434/v1
DOCS_READER_API_KEY=not-needed
# 디폴트 = 종합 벤치 최고 성능 모델 gemma3:4b (정확도 96.7%, 한국어 100%)
DOCS_READER_TEXT_MODEL=gemma3:4b
DOCS_READER_VISION_MODEL=qwen2.5vl:7b
# GPU(CUDA) 자동 사용: CLI --cuda 또는 아래 env (스냅 Ollama를 GPU로 :11500 자동 기동)
# DOCS_READER_CUDA=1
# 한국어 특화/대안(Ollama 태그 확인):
#   exaone3.5:7.8b (LG EXAONE) / qwen2.5:3b (가성비, 한국어 100%) / solar (Upstage)
#   비전: qwen2.5vl:7b / VARCO-VISION (NCSOFT)
# DOCS_READER_TEXT_MODEL=exaone3.5:7.8b

# ── Stage A OCR (scanned/image/HWP) ───────────────────────────────────────────
# auto | korean | paddle | easyocr | rapidocr | docling | none
# 한국어 문서는 korean(=PaddleOCR-korean → EasyOCR) 권장
DOCS_READER_OCR=korean
DOCS_READER_OCR_LANG=korean

# ── Gemini (escalation / cross-check, 2nd priority) ───────────────────────────
# GEMINI_API_KEY=your-gemini-key
# DOCS_READER_GEMINI_MODEL=gemini-2.5-flash

# ── Claude (escalation / cross-check, 3rd priority) ───────────────────────────
# ANTHROPIC_API_KEY=your-anthropic-key
# DOCS_READER_CLAUDE_MODEL=claude-opus-4-8
